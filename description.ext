// ============================================================================
// Function library — compiles functions/**/fn_*.sqf into Waldo_fnc_<name>.
// Branding: Waldo's Mission Pack. See functions/README.md for the layout.
// ============================================================================
class CfgFunctions
{
	class Waldo
	{
		class config
		{
			file = "functions\config";
			class loadParams {};        // Waldo_fnc_loadParams   (server: params + equipment)
			class buildArsenal {};      // Waldo_fnc_buildArsenal (server: dynamic intent-aware gear)
		};

		class core
		{
			file = "functions\core";
			class resetState {};        // Waldo_fnc_resetState  (idempotent round (re)init)
			class initServer {};        // Waldo_fnc_initServer  (round orchestrator)
			class initClient {};        // Waldo_fnc_initClient  (per-client setup)
			class applySpawnLoadout {}; // Waldo_fnc_applySpawnLoadout (random uniform/vest/headgear)
		};

		class arena
		{
			file = "functions\arena";
			class selectArena {};       // Waldo_fnc_selectArena
			class buildArena {};        // Waldo_fnc_buildArena
			class populateLoot {};      // Waldo_fnc_populateLoot
			class confineToArena {};    // Waldo_fnc_confineToArena
		};

		class env
		{
			file = "functions\env";
			class setupWeather {};      // Waldo_fnc_setupWeather
		};

		class round
		{
			file = "functions\round";
			class assignRoles {};       // Waldo_fnc_assignRoles
			class applyDetectiveLoadout {}; // Waldo_fnc_applyDetectiveLoadout
			class startRound {};        // Waldo_fnc_startRound
			class roundLoop {};         // Waldo_fnc_roundLoop
			class checkWin {};          // Waldo_fnc_checkWin
			class endRound {};          // Waldo_fnc_endRound
			class onKilled {};          // Waldo_fnc_onKilled
			class reviveRelink {};      // Waldo_fnc_reviveRelink (server: relinks role/lists onto a revived unit's NEW object)
			class roundMVP {};          // Waldo_fnc_roundMVP (server: finds + broadcasts the MVP)
		};

		class systems
		{
			file = "functions\systems";
			class spawnAirdrop {};      // Waldo_fnc_spawnAirdrop
			class applyKarma {};        // Waldo_fnc_applyKarma
			class c4Charge {};          // Waldo_fnc_c4Charge (server: traitor timed charge)
			class identifyBody {};      // Waldo_fnc_identifyBody (server: call in a corpse)
			class dnaContaminate {};    // Waldo_fnc_dnaContaminate (server: witness/contamination tracking)
			class spawnDecoyCorpse {};  // Waldo_fnc_spawnDecoyCorpse (server: Dead Ringer decoy)
		};

		class ui
		{
			file = "functions\ui";
			class initShops { preInit = 1; }; // defines shop catalogs on every machine
			class initHud {};           // Waldo_fnc_initHud
			class drawRoleIcons {};     // Waldo_fnc_drawRoleIcons
			class openBuyMenu {};       // Waldo_fnc_openBuyMenu
			class buyItem {};           // Waldo_fnc_buyItem
			class titleSequence {};     // Waldo_fnc_titleSequence
			class pregameScreen {};     // Waldo_fnc_pregameScreen
			class scoreboard {};        // Waldo_fnc_scoreboard (in-round scoreboard, K)
			class mvpCelebrate {};      // Waldo_fnc_mvpCelebrate (client: round-end MVP celebration)
		};

		class debug
		{
			file = "functions\debug";
			class debugInit { preInit = 1; };  // builds the extensible test-action registry + API
			class debugMenu {};                // Waldo_fnc_debugMenu (client: renders the registry)
			class debugExec {};                // Waldo_fnc_debugExec (server: runs a server action by index)
			class effectivePlayerCount {};     // Waldo_fnc_effectivePlayerCount (size scaling + sim override)
		};

		class roles
		{
			file = "functions\roles";
			class traitorRadar {};      // Waldo_fnc_traitorRadar
			class detectiveRadar {};    // Waldo_fnc_detectiveRadar
			class warpSmoke {};         // Waldo_fnc_warpSmoke
			class suicideBomb {};       // Waldo_fnc_suicideBomb
			class flowerPower {};       // Waldo_fnc_flowerPower
			class tester {};            // Waldo_fnc_tester
			class makeJester {};        // Waldo_fnc_makeJester
			class unmakeJester {};      // Waldo_fnc_unmakeJester (removes the fire-block on role switch)
			class revive {};            // Waldo_fnc_revive
			class healthStation {};     // Waldo_fnc_healthStation
			class holster {};           // Waldo_fnc_holster
			class removeBody {};        // Waldo_fnc_removeBody (traitor: destroy a corpse)
			class dnaScanner {};        // Waldo_fnc_dnaScanner (detective: track a killer)
			class placeC4 {};           // Waldo_fnc_placeC4 (traitor: place a timed charge)
			class traitorPing {};       // Waldo_fnc_traitorPing (traitor: silent coordination ping)
			class pingShow {};          // Waldo_fnc_pingShow (client: render a traitor ping)
			class deadRinger {};        // Waldo_fnc_deadRinger (traitor: arm a faked death)
			class deadRingerTrigger {}; // Waldo_fnc_deadRingerTrigger (client: sell the fake death)
		};
	};
};

class Params {
	// Params are read by INDEX in Waldo_fnc_loadParams; this block's ORDER is the
	// index. If you reorder or insert, update the reads there to match. Booleans
	// use {0,1} + a numeric read (a {False,True} value with a bool default is
	// ignored by the engine). Current order = indices 0..28.

	// === ROUND ===
	class roundBaseLength {                 // 0
		title = "Base Round Length (seconds)";
		values[] = {120, 150, 180, 210, 240};
		texts[]  = {"120", "150", "180", "210", "240"};
		default  = 180;
	};
	class roundPlayerLength {               // 1
		title = "Bonus Time Per Player (seconds)";
		values[] = {15, 30, 45};
		texts[]  = {"15", "30", "45"};
		default  = 30;
	};
	class roundTraitorLength {              // 2
		title = "Traitor Bonus Time (seconds)";
		values[] = {30, 45, 60};
		texts[]  = {"30", "45", "60"};
		default  = 45;
	};
	class roundDeadLength {                 // 3
		title = "Time Added Per Dead Player (seconds)";
		values[] = {15, 30, 45};
		texts[]  = {"15", "30", "45"};
		default  = 30;
	};
	class roundWarmupLength {               // 4
		title = "Warmup Length (seconds)";
		values[] = {10, 20, 30, 45};
		texts[]  = {"10", "20", "30", "45"};
		default  = 20;
	};

	// === ROLES ===
	class TraitorPercentageChanceLowerBound {   // 5
		title = "Traitor Chance Lower Bound";
		values[] = {20, 25, 30, 40};
		texts[]  = {"20%", "25%", "30%", "40%"};
		default  = 25;
	};
	class TraitorPercentageChanceHigherBound {  // 6
		title = "Traitor Chance Upper Bound";
		values[] = {40, 45, 50, 60};
		texts[]  = {"40%", "45%", "50%", "60%"};
		default  = 45;
	};
	class minTraitors {                     // 7
		title = "Minimum Traitors";
		values[] = {1, 2, 3};
		texts[]  = {"1", "2", "3"};
		default  = 1;
	};
	class maxTraitors {                     // 8
		title = "Maximum Traitors";
		values[] = {0, 2, 3, 4, 5, 8};
		texts[]  = {"Unlimited", "2", "3", "4", "5", "8"};
		default  = 0;
	};
	class DetectiveEnabled {                // 9
		title = "Enable Detective Role";
		values[] = {0, 1};
		texts[]  = {"Disabled", "Enabled"};
		default  = 1;
	};
	class DetectiveMinPlayers {             // 10
		title = "Detective: Minimum Players";
		values[] = {3, 4, 5, 6, 8};
		texts[]  = {"3", "4", "5", "6", "8"};
		default  = 5;
	};
	class JesterEnabled {                   // 11
		title = "Enable Jester Role";
		values[] = {0, 1};
		texts[]  = {"Disabled", "Enabled"};
		default  = 0;
	};
	class JesterAlways {                    // 12
		title = "Jester: Always Appears";
		values[] = {0, 1};
		texts[]  = {"No (use chance)", "Yes"};
		default  = 0;
	};
	class JesterPercentagechance {          // 13
		title = "Chance of Jester Appearing";
		values[] = {20, 30, 40};
		texts[]  = {"20%", "30%", "40%"};
		default  = 30;
	};

	// === GAMEPLAY ===
	class KarmaEnabled {                    // 14
		title = "Enable Karma System";
		values[] = {0, 1};
		texts[]  = {"Disabled", "Enabled"};
		default  = 1;
	};
	class startingCredits {                 // 15
		title = "Starting Shop Credits (base)";
		values[] = {0, 1, 2, 3, 5};
		texts[]  = {"0", "1", "2", "3", "5"};
		default  = 1;
	};

	// === AIRDROP / LOOT ===
	class airdrop {                         // 16
		title = "Enable Airdrops";
		values[] = {0, 1};
		texts[]  = {"Disabled", "Enabled"};
		default  = 1;
	};
	class airdropBaseTimer {                // 17
		title = "Airdrop Base Timer (seconds)";
		values[] = {30, 60, 75, 90, 120};
		texts[]  = {"30", "60", "75", "90", "120"};
		default  = 75;
	};
	class airdropRandomTimer {              // 18
		title = "Airdrop Random Add Time (seconds)";
		values[] = {0, 30, 60, 75, 90};
		texts[]  = {"0", "30", "60", "75", "90"};
		default  = 75;
	};
	class airdropLoadoutsAmount {           // 19
		title = "Loadouts Per Airdrop";
		values[] = {1, 2, 3};
		texts[]  = {"1", "2", "3"};
		default  = 1;
	};
	class lootMaxBullets {                  // 20
		title = "Max Ammo per Magazine";
		values[] = {30, 40, 50, 60, 75, 100};
		texts[]  = {"30", "40", "50", "60", "75", "100"};
		default  = 50;
	};
	class lootPower {                       // 21
		title = "Loot Power";
		values[] = {0, 1, 2};
		texts[]  = {"Low (SMGs / pistols)", "Balanced", "Anything (incl. rifles)"};
		default  = 1;
	};

	// === ENVIRONMENT ===
	class allowRain {                       // 22
		title = "Allow Rain?";
		values[] = {0, 1};
		texts[]  = {"No", "Yes"};
		default  = 1;
	};
	class chanceRain {                      // 23
		title = "Chance of Rain (%)";
		values[] = {0, 20, 40, 60, 80, 100};
		texts[]  = {"0%", "20%", "40%", "60%", "80%", "100%"};
		default  = 40;
	};
	class allowFog {                        // 24
		title = "Allow Fog?";
		values[] = {0, 1};
		texts[]  = {"No", "Yes"};
		default  = 1;
	};
	class chanceFog {                       // 25
		title = "Chance of Fog (%)";
		values[] = {0, 10, 20, 30, 40};
		texts[]  = {"0%", "10%", "20%", "30%", "40%"};
		default  = 20;
	};
	class timeOfDay {                       // 26
		title = "Time of Day";
		values[] = {0, 1, 2, 3, 4};
		texts[]  = {"Random", "Dawn", "Day", "Dusk", "Night"};
		default  = 0;
	};

	// === ARENA ===
	class arenaScale {                      // 27
		title = "Arena Size";
		values[] = {75, 100, 150};
		texts[]  = {"Small", "Normal", "Large"};
		default  = 100;
	};

	// === TESTING ===
	class TestingFlag {                     // 28
		title = "Enable Testing Mode";
		values[] = {0, 1};
		texts[]  = {"No", "Yes"};
		default  = 0;
	};

	// New params go at the END (file order = param index; see loadParams).
	class killRewardCredits {               // 29
		title = "Kill Reward Credits";
		values[] = {0, 1, 2, 3};
		texts[]  = {"0 (off)", "1", "2", "3"};
		default  = 1;
	};
};
